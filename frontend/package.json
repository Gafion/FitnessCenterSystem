{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:full": "playwright test --config playwright.full.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/react": "0.1.0-beta.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "27.2.1",
    "lucide-react": "^1.76.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "18.0.3",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "31.0.1",
    "knip": "6.46.1",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.4",
    "vitest": "5.1.1"
  },
  "overrides": {
    "brace-expansion@>=5": "5.0.12",
    "postcss": "8.5.28",
    "esbuild": "0.28.2",
    "minimatch@3.1.5": {
      "brace-expansion": "2.1.7"
    }
  },
  "packageManager": "bun@1.4.4"
}
