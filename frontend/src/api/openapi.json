  "components": {
    "schemas": {
      "AcceptStaffInviteForAccountRequest": {
        "required": [
          "inviteId",
          "code"
        ],
        "type": "object",
        "properties": {
          "inviteId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "AcceptStaffInviteRequest": {
        "required": [
          "inviteId",
          "code",
          "firstName",
          "lastName",
          "password"
        ],
        "type": "object",
        "properties": {
          "inviteId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthenticatorSetup": {
        "required": [
          "enabled",
          "sharedKey",
          "authenticatorUri"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "sharedKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "authenticatorUri": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ConfirmEmailRequest": {
        "required": [
          "accountId",
          "code"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "CurrentAccount": {
        "required": [
          "accountId",
          "email",
          "firstName",
          "lastName",
          "hasGoogleLogin",
          "twoFactorEnabled",
          "mustSetUpAuthenticator",
          "preferredLanguage",
          "staffRoles"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "hasGoogleLogin": {
            "type": "boolean"
          },
          "twoFactorEnabled": {
            "type": "boolean"
          },
          "mustSetUpAuthenticator": {
            "type": "boolean"
          },
          "preferredLanguage": {
            "type": "string"
          },
          "staffRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DoorOutcome": {
        "enum": [
          "welcome",
          "unknown-card",
          "payment-missing",
          "membership-ended"
        ]
      },
      "EnableAuthenticatorRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "GoogleSignupRequest": {
