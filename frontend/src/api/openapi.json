{
  "openapi": "3.1.1",
  "info": {
    "title": "FitnessCenter.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/identity/login": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/identity/logout": {
      "post": {
        "tags": [
          "Identity"
        ],
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/identity/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "operationId": "GetCurrentAccount",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentAccount"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/members/signup/terms": {
      "get": {
        "tags": [
          "Members"
        ],
        "operationId": "GetSignupTerms",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupTerms"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/signup": {
      "post": {
        "tags": [
          "Members"
        ],
        "operationId": "SignUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrentAccount": {
        "required": [
          "accountId",
          "email",
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SignupRequest": {
        "required": [
          "firstName",
          "lastName",
          "email",
          "password",
          "acceptTerms",
          "termsVersion",
          "startNow",
          "earlyStartVersion"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "acceptTerms": {
            "type": "boolean"
          },
          "termsVersion": {
            "type": "string"
          },
          "startNow": {
            "type": "boolean"
          },
          "earlyStartVersion": {
            "type": "string"
          }
        }
      },
      "SignupResponse": {
        "required": [
          "memberId"
        ],
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SignupTerms": {
        "required": [
          "membershipName",
          "monthlyPriceOre",
          "termsVersion",
          "termsText",
          "earlyStartVersion",
          "earlyStartText"
        ],
        "type": "object",
        "properties": {
          "membershipName": {
            "type": "string"
          },
          "monthlyPriceOre": {
            "type": "integer",
            "format": "int64"
          },
          "termsVersion": {
            "type": "string"
          },
          "termsText": {
            "type": "string"
          },
          "earlyStartVersion": {
            "type": "string"
          },
          "earlyStartText": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Identity"
    },
    {
      "name": "Members"
    }
  ]
}